{
  "image": "ghcr.io/developing-today/fleet-build:full",
  "customizations": {
    "codespaces": {
      "repositories": {
        "developing-today/.github": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/code": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/hardware-doc": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today-forks/openchamber": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today-forks/opencode": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/zettel": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "developing-today/zulip-archive": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/hatch": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/hatch-personal": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/darwin-nix": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        },
        "dezren39/zettel": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "jnoortheen.nix-ide",
        "golang.Go"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    }
  },
  "name": "fleet",
  "postCreateCommand": "bash -lc 'go version && nix --version && echo fleet-ready'",
  "remoteUser": "vscode",
  "updateContentCommand": "bash -lc 'git submodule update --init --jobs 4 code opencode openchamber nix zettel hatch dezren39-zettel org-readme zulip-archive hardware-doc ; git submodule update --init hatch-personal || echo hatch-personal-skipped-private ; git submodule update --init cairn || echo cairn-skipped-private'"
}